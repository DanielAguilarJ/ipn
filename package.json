{
  "name": "rumbo-ipn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Landing de captación y diagnóstico independiente para el curso de admisión al IPN de WorldBrain México",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:servidor && node scripts/prerender.mjs",
    "build:servidor": "vite build --ssr src/entrada-servidor.tsx --outDir dist/servidor",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
